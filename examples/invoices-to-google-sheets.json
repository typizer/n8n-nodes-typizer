{
	"name": "Счета из почты и Telegram → Typizer → Google Таблица",
	"nodes": [
		{
			"parameters": {
				"content": "## Счета → Google Таблица\nПрисылайте счёт боту в Telegram или письмом на ящик — каждая позиция счёта станет строкой таблицы.\n\n1. Подключите учётные данные **Typizer API** (ключ: my.typizer.ru → Ключи API), Telegram, IMAP и Google Sheets.\n2. В узле **Google Таблица** выберите свою таблицу и лист. Первая строка листа — заголовки: `number`, `date`, `supplier_name`, `supplier_inn`, `items_name`, `items_quantity`, `items_price`, `items_amount`, `total` (лишние колонки можно убрать).\n3. Активируйте сценарий.",
				"height": 340,
				"width": 420
			},
			"id": "0b9f6d0e-1d1a-4a51-9a1e-000000000001",
			"name": "Как настроить",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [-40, -380]
		},
		{
			"parameters": {
				"updates": ["message"],
				"additionalFields": {
					"download": true
				}
			},
			"id": "0b9f6d0e-1d1a-4a51-9a1e-000000000002",
			"name": "Счёт в Telegram",
			"type": "n8n-nodes-base.telegramTrigger",
			"typeVersion": 1.2,
			"position": [0, 0],
			"webhookId": "0b9f6d0e-1d1a-4a51-9a1e-0000000000a2"
		},
		{
			"parameters": {
				"format": "resolved",
				"dataPropertyAttachmentsPrefixName": "attachment_",
				"options": {
					"customEmailConfig": "[\"UNSEEN\"]"
				}
			},
			"id": "0b9f6d0e-1d1a-4a51-9a1e-000000000003",
			"name": "Счёт письмом",
			"type": "n8n-nodes-base.emailReadImap",
			"typeVersion": 2,
			"position": [0, 200]
		},
		{
			"parameters": {
				"resource": "document",
				"operation": "extract",
				"binaryPropertyName": "={{ Object.keys($binary ?? {})[0] }}",
				"documentSource": "preset",
				"preset": "schet-na-oplatu",
				"waitForResult": true,
				"splitLineItems": true,
				"options": {
					"flatten": true
				}
			},
			"id": "0b9f6d0e-1d1a-4a51-9a1e-000000000004",
			"name": "Typizer",
			"type": "n8n-nodes-typizer.typizer",
			"typeVersion": 1,
			"position": [280, 100]
		},
		{
			"parameters": {
				"operation": "append",
				"documentId": {
					"__rl": true,
					"mode": "url",
					"value": "https://docs.google.com/spreadsheets/d/ВАША_ТАБЛИЦА/edit"
				},
				"sheetName": {
					"__rl": true,
					"mode": "name",
					"value": "Счета"
				},
				"columns": {
					"mappingMode": "autoMapInputData",
					"value": {}
				},
				"options": {}
			},
			"id": "0b9f6d0e-1d1a-4a51-9a1e-000000000005",
			"name": "Google Таблица",
			"type": "n8n-nodes-base.googleSheets",
			"typeVersion": 4.5,
			"position": [560, 100]
		}
	],
	"connections": {
		"Счёт в Telegram": {
			"main": [[{ "node": "Typizer", "type": "main", "index": 0 }]]
		},
		"Счёт письмом": {
			"main": [[{ "node": "Typizer", "type": "main", "index": 0 }]]
		},
		"Typizer": {
			"main": [[{ "node": "Google Таблица", "type": "main", "index": 0 }]]
		}
	},
	"settings": {
		"executionOrder": "v1"
	}
}
