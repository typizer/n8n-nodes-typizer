{
  "name": "n8n-nodes-typizer",
  "version": "0.1.1",
  "description": "n8n nodes for Typizer: extract structured data from invoices, UPD, acts, contracts and any other document (PDF, scans, photos) into JSON",
  "license": "MIT",
  "homepage": "https://docs.typizer.ru/how-to/n8n",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "typizer",
    "document extraction",
    "invoice",
    "ocr",
    "upd",
    "1c"
  ],
  "author": {
    "name": "Typizer",
    "email": "support@typizer.ru"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/typizer/n8n-nodes-typizer.git"
  },
  "bugs": {
    "email": "support@typizer.ru"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "typecheck": "tsc --noEmit",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/TypizerApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Typizer/Typizer.node.js",
      "dist/nodes/TypizerTrigger/TypizerTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.56.3",
    "@types/node": "^24.19.2",
    "eslint": "9.39.4",
    "n8n-workflow": "2.16.0",
    "prettier": "3.8.3",
    "release-it": "19.2.4",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
